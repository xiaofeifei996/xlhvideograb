#!/bin/sh
# XLH VideoGrab 安装后处理
#
# dpkg 维护脚本的 "/" 语义：
#   - roothide："/" 是随机 jbroot，/var/mobile 落在 jbroot 里
#   - rootless(Dopamine)："/" 是真实 rootfs，/var/jb 才是越狱根
# 所以插件安装路径用 $JB 前缀，用户数据路径用真实（或 jbroot 内）的 /var/mobile。

if [ -d /var/jb ]; then
    JB=/var/jb
else
    JB=""
fi

# 1) 可执行权限（部分打包环境会丢执行位）
chmod 755 "$JB/usr/bin/xlgrab" 2>/dev/null || true
chmod 755 /usr/bin/xlgrab 2>/dev/null || true

# 2) ElleKit 从 TweakInject 加载，部分环境只认那一个目录
DYLIB="$JB/Library/MobileSubstrate/DynamicLibraries/XLHVideoGrab.dylib"
PLIST="$JB/Library/MobileSubstrate/DynamicLibraries/XLHVideoGrab.plist"
TI="$JB/usr/lib/TweakInject"
if [ -d "$TI" ] && [ -f "$DYLIB" ] && [ ! -e "$TI/XLHVideoGrab.dylib" ]; then
    ln -sf "$DYLIB" "$TI/XLHVideoGrab.dylib" 2>/dev/null || true
    ln -sf "$PLIST" "$TI/XLHVideoGrab.plist" 2>/dev/null || true
fi

# 3) 配置目录：与插件里 VGConfigDir() 完全一致
CFG=/var/mobile/Library/Preferences/xlhgrab
if [ ! -d /var/mobile ] && [ -d /rootfs/var/mobile ]; then
    CFG=/rootfs$CFG
fi
mkdir -p "$CFG" 2>/dev/null || true
chown mobile:mobile "$CFG" 2>/dev/null || true

exit 0
